{
  "name": "dsh-chonky-fps",
  "version": "2.0.1",
  "description": "大肥鱼专属帧率模式：四档锁定帧率（60/90/120/144Hz），带网页设置页与 dsh-go 原生面板。此帧率模式仅用于 DSH。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "frame-rate",
    "fps",
    "dsh-go"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "dsh.plugin.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "大肥鱼专属帧率模式",
      "en": "Chonky FPS"
    },
    "icon": "play",
    "contributes": {
      "composer.tools": [
        {
          "id": "frame",
          "label": {
            "zh": "帧率",
            "en": "FPS"
          },
          "icon": "play",
          "panel": "rates"
        }
      ],
      "panels": [
        {
          "id": "rates",
          "title": {
            "zh": "大肥鱼专属帧率",
            "en": "Chonky FPS"
          },
          "icon": "play",
          "placement": [
            "plugin",
            "features",
            "session.tab",
            "chat.panel"
          ]
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guanguming9-art/dsh-chonky-fps.git"
  },
  "homepage": "https://github.com/guanguming9-art/dsh-chonky-fps#readme",
  "bugs": {
    "url": "https://github.com/guanguming9-art/dsh-chonky-fps/issues"
  }
}
